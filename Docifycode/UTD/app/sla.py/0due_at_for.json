{"io_patterns":{"input":{"source":["datetime.datetime(2024, 6, 1, 12, 0, 0) # 有効なdatetime型","datetime.datetime(1970, 1, 1, 0, 0, 0) # 過去の境界値","datetime.datetime(9999, 12, 31, 23, 59, 59) # 未来の境界値","None # 無効な型（None）","123 # 無効な型（int）","'2024-06-01T12:00:00' # 無効な型（str）","Priority.HIGH # 有効なPriority型（例）","Priority.LOW # 有効なPriority型（例）","Priority.NORMAL # 有効なPriority型（例）","None # 無効な型（None）","5 # 無効な型（int）","'HIGH' # 無効な型（str）"],"flg":[],"method":{}},"output":{"return_values":["datetime.datetime(2024, 6, 1, 20, 0, 0) # Priority.HIGHの場合（SLA_HOURS[Priority.HIGH]=8の場合）","datetime.datetime(2024, 6, 1, 14, 0, 0) # Priority.LOWの場合（SLA_HOURS[Priority.LOW]=2の場合）","datetime.datetime(2024, 6, 1, 16, 0, 0) # Priority.NORMALの場合（SLA_HOURS[Priority.NORMAL]=4の場合）"],"exception":["TypeError # created_atがdatetime型でない場合","TypeError # priorityがPriority型でない場合","KeyError # priorityがSLA_HOURSに存在しない場合"]}},"possible_patterns":{"1":{"input":{"created_at":"datetime.datetime(2024, 6, 1, 12, 0, 0) # 有効なdatetime型","priority":"Priority.HIGH # 有効なPriority型"},"output":{"return_values":"datetime.datetime(2024, 6, 1, 20, 0, 0) # Priority.HIGHの場合（SLA_HOURS[Priority.HIGH]=8の場合）"},"note":"正常系：Priority.HIGHでSLA_HOURSが8の場合"},"2":{"input":{"created_at":"datetime.datetime(2024, 6, 1, 12, 0, 0) # 有効なdatetime型","priority":"Priority.LOW # 有効なPriority型"},"output":{"return_values":"datetime.datetime(2024, 6, 1, 14, 0, 0) # Priority.LOWの場合（SLA_HOURS[Priority.LOW]=2の場合）"},"note":"正常系：Priority.LOWでSLA_HOURSが2の場合"},"3":{"input":{"created_at":"datetime.datetime(2024, 6, 1, 12, 0, 0) # 有効なdatetime型","priority":"Priority.NORMAL # 有効なPriority型"},"output":{"return_values":"datetime.datetime(2024, 6, 1, 16, 0, 0) # Priority.NORMALの場合（SLA_HOURS[Priority.NORMAL]=4の場合）"},"note":"正常系：Priority.NORMALでSLA_HOURSが4の場合"},"4":{"input":{"created_at":"datetime.datetime(1970, 1, 1, 0, 0, 0) # 過去の境界値","priority":"Priority.HIGH # 有効なPriority型"},"output":{"return_values":"datetime.datetime(1970, 1, 1, 8, 0, 0) # Priority.HIGHの場合（SLA_HOURS