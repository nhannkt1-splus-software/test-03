{"io_patterns":{"input":{"source":["1 # ticket_id: 正常なint値","0 # ticket_id: 存在しないチケットID","-1 # ticket_id: 負の値","\"1\" # ticket_id: int型以外（str型）","null # ticket_id: None型","2 # ticket_id: 書き込み不可チケットID","0.5 # hours: 0より大きい正常なfloat値","MAX_WORKLOG_HOURS # hours: 上限値","MAX_WORKLOG_HOURS+0.1 # hours: 上限超過値","0 # hours: 0（不正値）","-1 # hours: 負の値（不正値）","\"2\" # hours: float型以外（str型）","null # hours: None型","100 # hours: チケットの残り時間を超える値","0.1 # hours: 境界値（最小値）","\"user\" # author: 正常なstr値","\" user \" # author: 前後に空白を含むstr値","\"\" # author: 空文字","null # author: None型","123 # author: str型以外（int型）","\"note\" # note: 正常なstr値","\" note \" # note: 前後に空白を含むstr値","\"\" # note: 空文字","null # note: None型","123 # note: str型以外（int型）"],"flg":["チケットが書き込み可能","チケットが書き込み不可","hoursが0以下","hoursがMAX_WORKLOG_HOURSを超える","hours_logged(ticket) + hoursがMAX_TICKET_HOURSを超える","authorが空文字","noteが空文字"],"method":{"_get_writable_ticket(ticket_id)":"例外（TicketNotWritableError） # ticket_idが無効または書き込み不可の場合","hours_logged(ticket)":"float値 # チケットに既に記録された時間","ticket.add_worklog(hours, author.strip(), note.strip())":"例外（WorklogAddError） # Worklog追加失敗時"}},"output":{"return_values":["Worklogインスタンス # 正常時","None # 例外発生時"],"exception":["InvalidWorklogError # hoursが0以下またはMAX_WORKLOG_HOURSを超える場合","WorklogLimitError # hours_logged(ticket) + hoursがMAX_TICKET_HOURSを超える場合","TicketNotWritableError # _get_writable_ticketでチケットが書き込み不可の場合","TypeError # ticket_id, hours, author, noteの型不一致時","WorklogAddError # ticket.add_worklogで追加失敗時"]}},"possible_patterns":{"1":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"1.0 # 0より大きくMAX_WORKLOG_HOURS未満のfloat値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"Worklogインスタンス # 正常時","exception":"None"},"note":"正常系：全ての入力が正常な場合"},"2":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"MAX_WORKLOG_HOURS # 上限値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"Worklogインスタンス # 正常時","exception":"None"},"note":"正常系：hoursが上限値（MAX_WORKLOG_HOURS）の場合"},"3":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"0.1 # 境界値（最小値）","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"Worklogインスタンス # 正常時","exception":"None"},"note":"正常系：hoursが最小の正の値（境界値）"},"4":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"0 # 不正値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"InvalidWorklogError # hoursが0"},"note":"異常系：hoursが0の場合"},"5":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"-1 # 不正値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"InvalidWorklogError # hoursが負の値"},"note":"異常系：hoursが負の値の場合"},"6":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"MAX_WORKLOG_HOURS+0.1 # 上限超過値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"InvalidWorklogError # hoursがMAX_WORKLOG_HOURS超過"},"note":"異常系：hoursが上限超過の場合"},"7":{"input":{"ticket_id":"1 # int型、存在するチケットID","hours":"100 # チケットの残り時間を超える値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"WorklogLimitError # hours_logged(ticket) + hoursがMAX_TICKET_HOURS超過"},"note":"異常系：hours_logged(ticket) + hoursがMAX_TICKET_HOURSを超える場合"},"8":{"input":{"ticket_id":"0 # 存在しないチケットID","hours":"1.0 # 正常なfloat値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"TicketNotWritableError # _get_writable_ticketで例外"},"note":"異常系：存在しないチケットID"},"9":{"input":{"ticket_id":"-1 # 負の値","hours":"1.0 # 正常なfloat値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"TicketNotWritableError # _get_writable_ticketで例外"},"note":"異常系：ticket_idが負の値"},"10":{"input":{"ticket_id":"2 # 書き込み不可チケットID","hours":"1.0 # 正常なfloat値","author":"\"user\" # 正常なstr値","note":"\"note\" # 正常なstr値"},"output":{"return_values":"None","exception":"TicketNotWritableE